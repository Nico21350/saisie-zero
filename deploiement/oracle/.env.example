# Modèle du fichier .env placé sur le serveur, dans /opt/saisie-zero/.env (droits 600).
# Les vraies valeurs sont générées sur le serveur et n'en sortent pas.

# Adresse publique du serveur écrite pour sslip.io (IP 1.2.3.4 : 1-2-3-4.sslip.io), qui la renvoie vers cette IP
DOMAINE=1-2-3-4.sslip.io

# Mot de passe de la base Postgres (généré : openssl rand -hex 24)
POSTGRES_PASSWORD=

# Clé qui chiffre les identifiants enregistrés dans n8n (générée : openssl rand -hex 32).
# Ne jamais la changer ensuite, sinon les identifiants deviennent illisibles.
N8N_ENCRYPTION_KEY=
