        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type_document\": { \"type\": \"string\", \"enum\": [\"facture\", \"devis\", \"autre\"] },\n    \"emetteur\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"nom\": { \"type\": [\"string\", \"null\"] },\n        \"numero_tva\": { \"type\": [\"string\", \"null\"] }\n      },\n      \"required\": [\"nom\", \"numero_tva\"]\n    },\n    \"client\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"nom\": { \"type\": [\"string\", \"null\"] },\n        \"numero_tva\": { \"type\": [\"string\", \"null\"] }\n      },\n      \"required\": [\"nom\", \"numero_tva\"]\n    },\n    \"numero\": { \"type\": [\"string\", \"null\"] },\n    \"date\": { \"type\": [\"string\", \"null\"], \"description\": \"AAAA-MM-JJ\" },\n    \"date_echeance\": { \"type\": [\"string\", \"null\"], \"description\": \"Facture uniquement, AAAA-MM-JJ\" },\n    \"date_validite\": { \"type\": [\"string\", \"null\"], \"description\": \"Devis uniquement, AAAA-MM-JJ\" },\n    \"lignes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"designation\": { \"type\": \"string\" },\n          \"quantite\": { \"type\": [\"number\", \"null\"] },\n          \"prix_unitaire_htva\": { \"type\": [\"number\", \"null\"] },\n          \"taux_tva\": { \"type\": [\"number\", \"null\"] }\n        },\n        \"required\": [\"designation\", \"quantite\", \"prix_unitaire_htva\", \"taux_tva\"]\n      }\n    },\n    \"total_htva\": { \"type\": [\"number\", \"null\"] },\n    \"montant_tva\": { \"type\": [\"number\", \"null\"] },\n    \"total_tvac\": { \"type\": [\"number\", \"null\"] }\n  },\n  \"required\": [\"type_document\", \"emetteur\", \"client\", \"numero\", \"date\", \"date_echeance\", \"date_validite\", \"lignes\", \"total_htva\", \"montant_tva\", \"total_tvac\"]\n}\n"
